rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile doc (not subcollections — covered separately)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // User subcollections (legacy data path)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Shared household
    match /households/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.members.hasAll(resource.data.members) &&
         request.resource.data.members.size() <= 6)
      );
      match /data/{key} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/households/$(code)).data.members;
      }

      // Server-authoritative quota counter for the managed AI proxy — the Cloud Function
      // uses the Admin SDK, which bypasses these rules entirely. No client ever needs
      // direct access to this collection.
      match /aiQuota/{day} {
        allow read, write: if false;
      }
    }

  }
}
